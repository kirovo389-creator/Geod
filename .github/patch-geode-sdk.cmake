# Work around a duplicate declaration in the Geode v5.3.0 SDK header.
# Upstream fix: geode-sdk/geode commit db626203f6.
if(DEFINED ENV{GEODE_SDK})
    set(_geode_sdk "$ENV{GEODE_SDK}")
    set(_header "${_geode_sdk}/loader/include/Geode/cocos/platform/win32/CCFileUtilsWin32.h")

    if(EXISTS "${_header}")
        file(READ "${_header}" _header_contents)
        set(_duplicate "    virtual bool init();\n\n    /**")
        string(FIND "${_header_contents}" "${_duplicate}" _duplicate_pos)

        if(NOT _duplicate_pos EQUAL -1)
            string(REPLACE "${_duplicate}" "    /**" _patched_contents "${_header_contents}")
            file(WRITE "${_header}" "${_patched_contents}")
            message(STATUS "DualMind workaround: removed duplicate CCFileUtilsWin32::init declaration")
        else()
            string(FIND "${_header_contents}" "    bool init();" _expected_declaration_pos)
            if(_expected_declaration_pos EQUAL -1)
                message(FATAL_ERROR "DualMind workaround: CCFileUtilsWin32.h does not match the known SDK header")
            endif()
            message(STATUS "DualMind workaround: duplicate declaration is already absent")
        endif()
    else()
        message(FATAL_ERROR "DualMind workaround: Geode SDK header not found at ${_header}")
    endif()
endif()
